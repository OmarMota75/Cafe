# Puerto del servidor
PORT=5000

# Base de datos MySQL (opcional, si no se define corre en memoria)
# DATABASE_URL=mysql://usuario:contraseña@localhost:3306/nombre_bd

# Configuración de Correo SMTP (Ejemplo con Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
# IMPORTANTE: En Gmail, SMTP_PASS debe ser una "Contraseña de aplicación" de 16 caracteres (no tu contraseña habitual)
# Para generarla: Cuenta de Google -> Seguridad -> Verificación en dos pasos -> Contraseñas de aplicaciones
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="2GetherRewards" <tu_correo@gmail.com>

# Correos de notificación interna de nuevos registros (separados por comas)
ADMIN_NOTIFICATION_EMAILS=ojmota@2getherrewards.com, bracadaniel07@outlook.com, barbaramc05@gmail.com

